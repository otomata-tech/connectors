type: { search: { type: companies } }
securedBy: [ basic-authentication, x-JWT-App, x-JWT-Client ]
description: Search & create companies

get:
  description: |
    Search companies

    _You can specify the output format by appending to the url **.csv**_
    *Example : {BASE_URL}/api/companies.csv?keywords=CSOC100*
  is: [ searchable, sortablePaginable: { sortList: "name | information | town | state | expertiseArea | mainManager.lastName | updateDate" } ]
  queryParameters:
    keywords:
      type: string
      description: |
        If `keywords = CSOC**ID1** CSOC**ID2**` then companies :
        * of which [unique identifier](../bddboondmanager/classes/TAB_CRMSOCIETE.html#property_ID_CRMSOCIETE) &isin; [__ID1__, __ID2__] are filtered.
    keywordsType:
      type: string
      default: "default"
      description: |
        * `default` : Companies are filtered following `keywords` found into their name, town, country, expertiseArea and information
        * `name` : Companies are filtered following `keywords` found into their name
        * `phones` : Companies are filtered following `keywords` found into their phones
        * `emails` : Companies are filtered following `keywords` found into their emails
        * `socialNetworks` : Companies are filtered following `keywords` found into their socialNetworks url
    returnMoreData:
      description: |
        Returns the following attributes or relationships, if specified and user is allowed to :
        * `previousAction`
        * `nextAction`
      type: string
      repeat: true
    states:
      type: integer
      repeat: true
      description: List of company states `id` to filter (described by [/api/rest/application/dictionary/setting.state.company](#rest_application_dictionary))
    expertiseAreas:
      type: string
      repeat: true
      description: List of company expertise areas `id` to filter (described by [/api/rest/application/dictionary/setting.expertiseArea](#rest_application_dictionary))
    origins:
      type: string
      repeat: true
      description: List of company origins `id` to filter (described by [/api/rest/application/dictionary/setting.origin](#rest_application_dictionary))
    period:
      type: string
      description: |
        * `created` : Companies created between `startDate` and `endDate` are filtered
        * `updated` : Companies updated between `startDate` and `endDate` are filtered
        * `noAction` : Companies whose do not have actions between `startDate` and `endDate` are filtered
        * `withActions`: Companies whose actions exist between `startDate` and `endDate` are filtered
        * `withoutActions`: Companies whose actions dont exist between `startDate` and `endDate` are filtered
        * `<appId>_running` : App entities whose the period field between `startDate` and `endDate` are filtered
        * `<appId>_started` : App entities whose the period field between `startDate` and `endDate` are filtered
        * `<appId>_stopped` : App entities whose the period field between `startDate` and `endDate` are filtered
        * `<appId>_fieldId` : App entities whose date or datetime field between `startDate` and `endDate` are filtered
    periodActions:
      type: integer
      repeat: true
      description: List of actions `id` (../bddboondmanager/classes/TAB_ACTION.html#property_ACTION_TYPE described by [/api/rest/application/dictionary/setting.action.contact](#rest_application_dictionary) = integer
    periodDynamic:
      type: string
      description: |
        * `today` : Companies filtered according to the grid for today's period
        * `thisWeek` : Companies filtered according to the mesh for the period of this week
        * `thisMonth` : Companies filtered according to the mesh for the period of this month
        * `thisTrimester` : Companies filtered according to the mesh for the period of this trimester
        * `thisSemester` : Companies filtered according to the mesh for the period of this semester
        * `thisYear` : Companies filtered according to the mesh for the period of this year
        * `thisFiscalYear` : Companies filtered according to the mesh for the period of this fiscal year
        * `yesterday` : Companies filtered according to the mesh for the period of yesterday
        * `lastWeek` : Companies filtered according to the mesh for the period of last week
        * `lastMonth` : Companies filtered according to the mesh for the period of last month
        * `lastTrimester` : Companies filtered according to the mesh for the period of last trimester
        * `lastSemester` : Companies filtered according to the mesh for the period of last semester
        * `lastYear` : Companies filtered according to the mesh for the period of last year
        * `lastFiscalYear` : Companies filtered according to the mesh for the period of last fiscal year
        * `tomorrow` : Companies filtered according to the mesh for the period of tomorrow
        * `nextWeek` : Companies filtered according to the mesh for the period of next week
        * `nextMonth` : Companies filtered according to the mesh for the period of next month
        * `nextTrimester` : Companies filtered according to the mesh for the period of next trimester
        * `nextSemester` : Companies filtered according to the mesh for the period of next semester
        * `nextYear` : Companies filtered according to the mesh for the period of next year
        * `nextFiscalYear` : Companies filtered according to the mesh for the period of next fiscal year
        * `lastCustomPeriod` : Companies filtered according to the mesh from the last custom period until now
        * `nextCustomPeriod` : Companies filtered according to the mesh for the next custom period from now
    periodDynamicParameters:
      type: string
      description: |
        Filter parameters of dynamic period. Used when periodDynamic is "lastCustomPeriod" or "nextCustomPeriod"
        You need two values separated by "," (duration,unit) eg (3,months)

        * `1,n` : Duration of the custom period (max 100)
        * `days,weeks,months,trimesters,semesters,years` : Unit of the custom period
    startDate:
      type: string
      pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$ [0-9]{2}:[0-9]{2}:[0-9]{2}$
      description: Start date
    endDate:
      type: string
      pattern: ^[0-9]{4}-[0-9]{2}-[0-9]{2}$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$ [0-9]{2}:[0-9]{2}:[0-9]{2}$
      description: End date
    flags:
      type: integer
      repeat: true
      description: Companies attached to this flag whom [flag's unique identifier = integer](../bddboondmanager/classes/TAB_USERFLAG.html#property_ID_USERFLAG) are filtered
    columns:
      type: string
      repeat: true
      description: |
        List of columns
        * `name`
        * `expertiseAreas`
        * `informationComments`
        * `state`
        * `billingDetails`
        * `town`
        * `mainManager`
        * `creationDate`
        * `updateDate`
    encoding:
      type: string
      description: |
        If the output format is **csv** then **encoding** filter should be one of :
        * `UTF-8`
        * `ISO-8859-15`
        * `WINDOWS-1250`
        * `MAC-OS-ROMAN`
    appEntityFields:
      type: string
      repeat: true
      description: |
        List of app entity responses filtered by `<appId>_<fieldId>:<responseValue>` and with html characters encoded
    influencers:
      type: integer
      repeat: true
      description: List of company influencers `id` to filter
    shields:
      type: string
      repeat: true
      description: |
        Filter companies by their shield status (conditional fields completion level):
        * `uncomplete` : Required fields are missing
        * `minimum` : Required fields OK, recommended fields missing
        * `complete` : All conditional fields are filled

