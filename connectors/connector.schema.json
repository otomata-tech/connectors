{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otomata-tech/connectors/connectors/connector.schema.json",
  "title": "Connector description",
  "description": "One file per connector: what the agent sees (name, description, input schema, class, examples, named refusals) and the call behind it. Python and TypeScript are generated from it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["connector", "functions"],
  "properties": {
    "connector": { "$ref": "#/$defs/connector" },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/function" }
    },
    "exposure": { "$ref": "#/$defs/exposure" }
  },
  "if": {
    "properties": { "connector": { "not": { "anyOf": [{ "required": ["base_url"] }, { "required": ["base_urls"] }] } } }
  },
  "then": {
    "$comment": "Without base_url or base_urls, every function must be handwritten.",
    "properties": { "functions": { "items": { "required": ["handwritten"] } } }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "http_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "argument_map": {
      "description": "API-side name to input argument name. Each input argument goes to one place only.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/identifier" }
    },
    "constant_headers": {
      "description": "Header name to a constant value. Never a secret: the file is public.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9-]+$" },
      "additionalProperties": { "type": "string" }
    },
    "check": {
      "description": "A check of the input before the call: when it fails, nothing is sent and the named refusal is returned.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "refusal", "items", "fields"],
          "properties": {
            "kind": {
              "description": "Over the items of a list argument, the sum of the first field equals the sum of the second; decimal strings are summed exactly.",
              "const": "equal_sums"
            },
            "refusal": { "$ref": "#/$defs/identifier" },
            "items": { "description": "Input argument holding the list.", "$ref": "#/$defs/identifier" },
            "fields": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/identifier" } }
          }
        }
      ]
    },
    "expectation": {
      "description": "A check of the response: when it fails, the named refusal is returned instead of the response.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "refusal", "path"],
          "properties": {
            "kind": {
              "description": "The value at path is present and is not null, nor an empty string, list or object.",
              "const": "non_empty"
            },
            "refusal": { "$ref": "#/$defs/identifier" },
            "path": { "description": "Dotted path in the response.", "$ref": "#/$defs/text" }
          }
        }
      ]
    },
    "url_template": {
      "description": "An https URL without trailing slash. It may cite settings as {name}: a url setting (or a value read from the token) only at its head, where it stands for the scheme and the host; any other setting after https://.",
      "type": "string",
      "pattern": "^(https://[^\\s]*[^/\\s]|\\{[a-z][a-z0-9_]*\\}([^\\s]*[^/\\s])?)$"
    },
    "urls_by_setting": {
      "description": "One https URL per value of a choice setting: every choice has its URL.",
      "type": "object",
      "additionalProperties": false,
      "required": ["setting", "values"],
      "properties": {
        "setting": { "description": "A choice setting.", "$ref": "#/$defs/identifier" },
        "values": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "type": "string", "pattern": "^https://[^\\s{}]*[^/\\s{}]$" }
        }
      }
    },
    "setting": {
      "description": "A non-secret setting of an account, entered by whoever connects it: a region in a closed list, a free address, or a text checked by a pattern.",
      "type": "object",
      "required": ["name", "label", "type"],
      "properties": { "type": { "enum": ["choice", "text", "url"] } },
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["choices"],
          "properties": {
            "name": { "$ref": "#/$defs/identifier" },
            "label": { "$ref": "#/$defs/text" },
            "type": { "description": "A value of a closed list.", "const": "choice" },
            "choices": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" }
            },
            "default": { "description": "One of the choices, taken when the account sets none.", "type": "string" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["pattern"],
          "properties": {
            "name": { "$ref": "#/$defs/identifier" },
            "label": { "$ref": "#/$defs/text" },
            "type": { "description": "A free text checked by pattern, such as the subdomain of a tenant.", "const": "text" },
            "pattern": { "description": "Anchored regular expression the value must match.", "type": "string", "pattern": "^\\^.+\\$$" }
          }
        },
        {
          "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/$defs/identifier" },
            "label": { "$ref": "#/$defs/text" },
            "type": {
              "description": "A free https address entered by an admin. At run time: https only, never a host that resolves to an internal address, no redirect followed.",
              "const": "url"
            }
          }
        }
      ]
    },
    "handwritten": {
      "description": "Code written by hand, referenced from the file. The rest of the entry stays declarative.",
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "typescript"],
      "properties": {
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["module", "function"],
          "properties": {
            "module": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" },
            "function": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
          }
        },
        "typescript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "export"],
          "properties": {
            "file": { "$ref": "#/$defs/text" },
            "export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
          }
        }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "namespace", "version", "api_version", "auth", "modes", "errors"],
      "properties": {
        "name": {
          "description": "Stable identifier, first segment of the tools.",
          "$ref": "#/$defs/identifier"
        },
        "label": { "description": "Display name.", "$ref": "#/$defs/text" },
        "namespace": {
          "description": "Prefix of the exposed tools, often equal to name.",
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "description": "Version of this file, semver.",
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "api_version": {
          "description": "Version of the third-party API, as the vendor names it.",
          "$ref": "#/$defs/text"
        },
        "base_url": {
          "description": "Root of the call paths, possibly a template over settings. base_url or base_urls is required unless every function is handwritten.",
          "$ref": "#/$defs/url_template"
        },
        "base_urls": {
          "description": "Root of the call paths per value of a choice setting, such as a region.",
          "$ref": "#/$defs/urls_by_setting"
        },
        "auth": { "$ref": "#/$defs/auth" },
        "settings": {
          "description": "Non-secret settings of an account, beside its credential.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/setting" }
        },
        "credential": {
          "description": "Secret and non-secret fields of the credential supplied by the consumer: an account keeps every one. Required unless auth.kind is none or oauth2_user, which forbid it (the tokens of a consent are not credential fields).",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "label", "secret"],
            "properties": {
              "name": { "$ref": "#/$defs/identifier" },
              "label": { "$ref": "#/$defs/text" },
              "secret": { "type": "boolean" }
            }
          }
        },
        "modes": {
          "description": "Who may hold an account. Current vocabulary, to be aligned with organisation, team and person.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["platform", "byo_user", "byo_org"] }
        },
        "timeout_s": {
          "description": "Timeout of one call, in seconds.",
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "quota": {
          "description": "Default quota on a platform key. Absent when the connector has no platform key. Shape still to be fixed.",
          "type": "object",
          "minProperties": 1
        },
        "query_arrays": {
          "description": "Encoding of lists in the query string.",
          "enum": ["repeat", "brackets", "comma"]
        },
        "headers": {
          "description": "Constant headers sent with every request of every function.",
          "$ref": "#/$defs/constant_headers"
        },
        "rate_limit": {
          "description": "Highest rate the third party accepts, per credential: at most `requests` requests every `seconds` seconds.",
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "seconds"],
          "properties": {
            "requests": { "type": "integer", "minimum": 1 },
            "seconds": { "type": "integer", "minimum": 1 }
          }
        },
        "probe": {
          "description": "The function that checks a connection: a read function without required argument, never counted against a quota.",
          "type": "object",
          "additionalProperties": false,
          "required": ["function"],
          "properties": {
            "function": { "$ref": "#/$defs/identifier" },
            "non_empty": {
              "description": "Dotted paths that must be present and non-empty in its response.",
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/text" }
            }
          }
        },
        "errors": {
          "description": "Error table shared by every function.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "code", "message", "retryable"],
            "properties": {
              "status": {
                "oneOf": [
                  { "$ref": "#/$defs/http_status" },
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/http_status" }
                  }
                ]
              },
              "code": { "$ref": "#/$defs/identifier" },
              "message": { "$ref": "#/$defs/text" },
              "retryable": { "type": "boolean" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "auth": { "properties": { "kind": { "enum": ["none", "oauth2_user"] } } } }
          },
          "then": { "not": { "required": ["credential"] } },
          "else": { "required": ["credential"] }
        },
        { "not": { "required": ["base_url", "base_urls"] } }
      ],
      "dependentSchemas": {
        "quota": {
          "properties": { "modes": { "contains": { "const": "platform" } } }
        }
      }
    },
    "auth": {
      "description": "Other keys depend on kind. Values naming a secret refer to connector.credential[].name; a URL template cites connector.settings[].name.",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["api_key", "bearer", "basic", "oauth2_client_credentials", "oauth2_user", "none"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "api_key" },
            "in": { "description": "Where the key goes: a header, or the query of every call (masked in every log at run time).", "enum": ["header", "query"] },
            "name": { "description": "Name of the header or of the query parameter.", "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
            "prefix": { "description": "Header only: text sent before the key.", "type": "string" },
            "key": { "description": "Credential field sent.", "$ref": "#/$defs/identifier" }
          },
          "required": ["kind", "in", "name", "key"],
          "additionalProperties": false,
          "if": { "properties": { "in": { "const": "query" } } },
          "then": { "not": { "required": ["prefix"] } }
        },
        {
          "properties": {
            "kind": { "const": "bearer" },
            "token": { "description": "Credential field sent as the bearer token.", "$ref": "#/$defs/identifier" }
          },
          "required": ["kind", "token"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "basic" },
            "username": { "description": "Credential field.", "$ref": "#/$defs/identifier" },
            "password": { "description": "Credential field.", "$ref": "#/$defs/identifier" }
          },
          "required": ["kind", "username", "password"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "oauth2_client_credentials" },
            "token_url": { "$ref": "#/$defs/url_template" },
            "token_urls": { "$ref": "#/$defs/urls_by_setting" },
            "token_request": { "description": "Body of the token request.", "enum": ["json", "form"] },
            "client_auth": { "$ref": "#/$defs/client_auth" },
            "client_id": { "description": "Credential field.", "$ref": "#/$defs/identifier" },
            "client_secret": { "description": "Credential field.", "$ref": "#/$defs/identifier" },
            "scope": { "type": "string" },
            "expires_in_default": { "type": "integer", "minimum": 1 }
          },
          "required": ["kind", "token_request", "client_auth", "client_id", "client_secret"],
          "oneOf": [{ "required": ["token_url"] }, { "required": ["token_urls"] }],
          "additionalProperties": false
        },
        {
          "description": "A person's consent (authorization code). The OAuth application (client id and secret) belongs to the host, or to the organization that sets its own: it is neither in this file nor in credential. The tokens the consent yields are not credential fields.",
          "properties": {
            "kind": { "const": "oauth2_user" },
            "authorize_url": { "$ref": "#/$defs/url_template" },
            "token_url": { "description": "Token endpoint, called with a form body (authorization code, refresh, exchange).", "$ref": "#/$defs/url_template" },
            "token_urls": { "$ref": "#/$defs/urls_by_setting" },
            "client_auth": { "$ref": "#/$defs/client_auth" },
            "scopes": { "description": "Joined by spaces in the authorization request.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
            "authorize_params": {
              "description": "Constant parameters added to the authorization URL. Never one the host sets itself.",
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_.-]+$",
                "not": { "enum": ["client_id", "redirect_uri", "response_type", "scope", "state", "code_challenge", "code_challenge_method"] }
              },
              "additionalProperties": { "type": "string" }
            },
            "pkce": { "description": "Proof key for code exchange, by SHA-256.", "const": "S256" },
            "refresh": {
              "description": "refresh_token: the refresh token grant; exchange: the current access token is exchanged for a new one; none: the token lives until it expires or is revoked, then the person consents again.",
              "enum": ["refresh_token", "exchange", "none"]
            },
            "rotates": { "description": "With refresh_token: each refresh returns a new refresh token that replaces the old one.", "type": "boolean" },
            "exchange": {
              "description": "With exchange: the grant type, and the form parameter that carries the current access token.",
              "type": "object",
              "additionalProperties": false,
              "required": ["grant_type", "token_param"],
              "properties": {
                "grant_type": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
                "token_param": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
              }
            },
            "expires_in_default": { "description": "Lifetime in seconds of an access token whose response gives none.", "type": "integer", "minimum": 1 },
            "identity": {
              "description": "Who consented, read right after the consent to name the account: a read function without required argument, and the dotted path of a non-empty value in its response.",
              "type": "object",
              "additionalProperties": false,
              "required": ["function", "path"],
              "properties": {
                "function": { "$ref": "#/$defs/identifier" },
                "path": { "$ref": "#/$defs/text" }
              }
            },
            "from_token": {
              "description": "Fields of the token response kept with the account, not secret, renewed at each token response, and citable in base_url like a setting.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/identifier" }
            }
          },
          "required": ["kind", "authorize_url", "client_auth", "refresh", "identity"],
          "oneOf": [{ "required": ["token_url"] }, { "required": ["token_urls"] }],
          "allOf": [
            {
              "if": { "properties": { "refresh": { "const": "refresh_token" } } },
              "then": { "required": ["rotates"] },
              "else": { "not": { "required": ["rotates"] } }
            },
            {
              "if": { "properties": { "refresh": { "const": "exchange" } } },
              "then": { "required": ["exchange"] },
              "else": { "not": { "required": ["exchange"] } }
            }
          ],
          "additionalProperties": false
        },
        {
          "properties": { "kind": { "const": "none" } },
          "required": ["kind"],
          "additionalProperties": false
        }
      ]
    },
    "client_auth": {
      "description": "How the client id and secret reach the token endpoint: in the request body, or as HTTP Basic.",
      "enum": ["body", "basic"]
    },
    "input_schema": {
      "description": "JSON Schema of the function input: a strict object.",
      "allOf": [
        { "$ref": "https://json-schema.org/draft/2020-12/schema" },
        {
          "type": "object",
          "required": ["type", "additionalProperties", "properties"],
          "properties": {
            "type": { "const": "object" },
            "additionalProperties": { "const": false },
            "properties": { "type": "object" }
          }
        }
      ]
    },
    "output_schema": {
      "description": "JSON Schema of one output record: a strict object, closed on the keys this connector promises — not every key is present on every call (a caller may narrow with its own `fields`/`embed`-style argument), but no key outside this set ever appears.",
      "allOf": [
        { "$ref": "https://json-schema.org/draft/2020-12/schema" },
        {
          "type": "object",
          "required": ["type", "additionalProperties", "properties"],
          "properties": {
            "type": { "const": "object" },
            "additionalProperties": { "const": false },
            "properties": { "type": "object", "minProperties": 1 }
          }
        }
      ]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "class", "description", "input", "examples"],
      "properties": {
        "name": { "description": "A verb and its object.", "$ref": "#/$defs/identifier" },
        "class": { "enum": ["read", "write", "sensitive"] },
        "description": { "description": "What the agent reads, in English.", "$ref": "#/$defs/text" },
        "input": { "$ref": "#/$defs/input_schema" },
        "examples": {
          "description": "Each input is validated against the function input.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "input"],
            "properties": {
              "title": { "$ref": "#/$defs/text" },
              "input": { "type": "object" }
            }
          }
        },
        "refusals": {
          "description": "Overrides or completes the connector error table.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "when", "message"],
            "properties": {
              "code": { "$ref": "#/$defs/identifier" },
              "when": {
                "description": "HTTP status, or a condition.",
                "oneOf": [{ "$ref": "#/$defs/http_status" }, { "$ref": "#/$defs/text" }]
              },
              "message": { "$ref": "#/$defs/text" }
            }
          }
        },
        "checks": {
          "description": "Checks of the input before the call; each names one of the function's refusals.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check" }
        },
        "expect": {
          "description": "Checks of the response; each names one of the function's refusals.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/expectation" }
        },
        "call": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "path": {
              "description": "Relative to base_url, with {param} placeholders naming input arguments.",
              "type": "string",
              "pattern": "^/[^\\s?#]*$"
            },
            "query": { "$ref": "#/$defs/argument_map" },
            "body": { "description": "JSON body, whatever the method: a DELETE may carry one.", "$ref": "#/$defs/argument_map" },
            "headers": { "$ref": "#/$defs/argument_map" },
            "constants": {
              "description": "Values sent with every call of this function. They are not arguments: the agent neither sees nor sets them.",
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "query": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": { "type": ["string", "number", "boolean"] }
                },
                "body": { "type": "object", "minProperties": 1 },
                "headers": { "$ref": "#/$defs/constant_headers" }
              }
            },
            "encode": {
              "description": "Argument name to its encoding before it is placed: json serialises a structured argument into one string.",
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/identifier" },
              "additionalProperties": { "enum": ["json"] }
            }
          }
        },
        "pagination": {
          "description": "When present, all_pages and max_pages are added to the served input schema.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "request_param", "next", "max_pages"],
          "properties": {
            "kind": { "enum": ["cursor", "page"] },
            "request_param": { "description": "Input argument carrying the cursor or page number.", "$ref": "#/$defs/identifier" },
            "next": { "description": "Dotted path of the next cursor or page number in the response.", "$ref": "#/$defs/text" },
            "total": { "description": "Dotted path of the total count in the response.", "$ref": "#/$defs/text" },
            "more": {
              "description": "Dotted path of a boolean in the response: false means this page is the last, whatever next holds.",
              "$ref": "#/$defs/text"
            },
            "max_pages": { "type": "integer", "minimum": 1 }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": { "description": "Shape of one record, after items/strip/projection are applied.", "$ref": "#/$defs/output_schema" },
            "items": { "description": "Dotted path of the list in the response.", "$ref": "#/$defs/text" },
            "strip": { "description": "Keys removed.", "type": "array", "items": { "$ref": "#/$defs/text" } },
            "projection": { "description": "Keys kept.", "type": "array", "items": { "$ref": "#/$defs/text" } }
          }
        },
        "cost": {
          "description": "Unit counted against the quota.",
          "type": "object",
          "additionalProperties": false,
          "required": ["per"],
          "properties": {
            "per": { "enum": ["request", "page"] }
          }
        },
        "confirm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "properties": {
            "summary": { "description": "Template shown before execution, with {param} placeholders.", "$ref": "#/$defs/text" }
          }
        },
        "handwritten": { "$ref": "#/$defs/handwritten" }
      },
      "allOf": [
        {
          "$comment": "call and handwritten are exclusive; one of them is required.",
          "oneOf": [
            { "required": ["call"], "not": { "required": ["handwritten"] } },
            { "required": ["handwritten"], "not": { "required": ["call"] } }
          ]
        },
        {
          "if": { "properties": { "class": { "const": "sensitive" } } },
          "then": { "required": ["confirm"] }
        }
      ]
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "description": "Overrides the instance default for this connector.",
          "enum": ["per_action", "per_connector", "via_call"]
        },
        "tool": {
          "description": "Name of the single tool in per_connector mode; namespace otherwise.",
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
